# Agri Rover Backend Environment Configuration Example
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=backend/instance/logs
DATABASE_PATH=backend/instance/rover_history.db
FRONTEND_DIST_PATH=../frontend/dist

# Hardware
SERIAL_PORT=auto
SERIAL_BAUD=115200
COMMAND_TIMEOUT_MS=400
COMMAND_MAX_PER_SECOND=10

# Security & PIN
CONTROL_PIN=1234
ALLOW_CONTROL_WITHOUT_PIN=false
SESSION_IDLE_MINUTES=30
PIN_MAX_ATTEMPTS_PER_MINUTE=5

# ML & Inference
MODEL_ENABLED=false
MODEL_PATH=
INFERENCE_ENABLED=true
INFERENCE_MAX_FPS=2
FRAME_MAX_WIDTH=640
JPEG_QUALITY=75

# Camera
CAMERA_CONNECT_TIMEOUT_SECONDS=8
STALE_FRAME_SECONDS=5
RECONNECT_BACKOFF_MAX_SECONDS=15
DETECTION_COOLDOWN_SECONDS=2.0
REPLAY_VIDEO_PATH=
